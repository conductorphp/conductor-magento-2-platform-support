{#-
    CTAP-2123. TLS certificate paths may be relative to the Magento root (conductor renders them under
    var/tls/ from base64 environment variables, like the JWT keys) and may be EMPTY files when the
    variable is unset, which means "none". The checks are plain expressions, not closures: Magento
    rewrites env.php through var_export(), which keeps the value an expression produced.
-#}
{%- macro tls_path(path) -%}
{%- if path starts with '/' -%}'{{ path }}'{%- else -%}BP . '/{{ path }}'{%- endif -%}
{%- endmacro -%}
{%- macro tls_present(path) -%}
{%- import _self as tls -%}
(is_file({{ tls.tls_path(path) }}) && filesize({{ tls.tls_path(path) }}) > 0)
{%- endmacro -%}
